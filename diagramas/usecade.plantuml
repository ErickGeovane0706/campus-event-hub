@startuml
left to right direction
skinparam packageStyle rectangle

actor "Usuário" as User
actor "Aluno" as Student
actor "Professor" as Teacher
actor "Administrador" as Admin
actor "Temporizador do Sistema" as Timer << Service >>
actor "Serviço de E-mail" as MailService << System >>

' Herança de Atores
User <|-- Student
User <|-- Teacher
User <|-- Admin

package "Sistema de Cursos e Eventos" {

  package "Módulo de Administração & Infraestrutura" {
    usecase "Manter Cadastro de Salas" as UC_ManageRooms
    usecase "Manter Cadastro de Usuários" as UC_ManageUsers
    usecase "Aprovar Reservas Excepcionais" as UC_ApproveRoom
  }

  package "Gestão de Eventos e Reservas" {
    usecase "Cadastrar Evento" as UC_CreateEvent
    usecase "Reservar Sala do Instituto" as UC_ReserveRoom
    usecase "Validar Conflito de Horário" as UC_CheckConflict
    usecase "Cancelar Evento / Reserva" as UC_CancelEvent
  }

  package "Gestão de Participantes" {
    usecase "Inscrever-se em Evento" as UC_Register
    usecase "Gerenciar Lista de Participantes" as UC_ManageParticipants
    usecase "Disparar Lembretes de Eventos" as UC_SendReminders
  }

}

' Ações de Usuários (Geral)
User --> UC_Register

' Ações de Organizadores (Alunos e Professores)
Student --> UC_CreateEvent
Teacher --> UC_CreateEvent

Student --> UC_ReserveRoom
Teacher --> UC_ReserveRoom

Student --> UC_ManageParticipants
Teacher --> UC_ManageParticipants

Student --> UC_CancelEvent
Teacher --> UC_CancelEvent

' Ações do Administrador
Admin --> UC_ManageRooms
Admin --> UC_ManageUsers
Admin --> UC_ApproveRoom
Admin --> UC_CancelEvent

' Regras e Inclusões
UC_ReserveRoom .> UC_CheckConflict : <<include>>
UC_CreateEvent .> UC_ReserveRoom : <<include>>

' Automação de Lembretes
Timer --> UC_SendReminders
UC_SendReminders --> MailService

@endluml